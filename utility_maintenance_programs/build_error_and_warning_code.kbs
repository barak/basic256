# ==========================================================================
#  Generate the boilerplate for every error and warning constant.
#
#  Adding an ERROR_ or WARNING_ to src/core/ErrorCodes.h means hand-editing
#  five other places. This reads that header, pulls each message text out of
#  src/core/Error.cpp, and prints all five blocks ready to paste:
#
#    * pattern definitions          -> LEX/basicParse.l
#    * pattern -> terminal rules    -> LEX/basicParse.l
#    * %token declarations          -> LEX/basicParse.y
#    * expression rules             -> LEX/basicParse.y
#    * keyword list                 -> src/gui/EditSyntaxHighlighter.cpp
#
#  plus a Markdown table of name / number / message for the documentation
#  site. Everything is sorted alphabetically, which is how the existing
#  blocks in those files are ordered.
#
#  Run it with the working directory set to either the repository root or
#  this folder -- it finds src/core either way.
#
#  2020-04-17 j.m.reneau  original
#  2026-07-30 the sources moved to src/core, so the old ../ paths opened
#             nothing. Warning values are now resolved as expressions:
#             they are written WARNING_START + ERROR_x, and reading the
#             last token as a number silently reported every one of them
#             as 0.
# ==========================================================================

maxcodes = 400
dim e(maxcodes)		# constant name
dim en(maxcodes)	# numeric value
dim et(maxcodes)	# message text from Error.cpp
le = 0
tab = chr(9)

# Find src/core whether we were started from the repository root or here.
base = ""
if exists("src/core/ErrorCodes.h") then base = "src/core/"
if exists("../src/core/ErrorCodes.h") then base = "../src/core/"
if base = "" then
	print "Cannot find src/core/ErrorCodes.h."
	print "Run this from the repository root or from utility_maintenance_programs."
	end
endif
print "Reading "; base; "ErrorCodes.h"
print

open 1, base + "ErrorCodes.h"
while not eof(1)
	l = readline(1)
	l = replace(l,tab,' ')
	la = explode(l,' ')
	if la[0] = "#define" then
		if le >= maxcodes then
			print "More than "; maxcodes; " constants - raise maxcodes at the top."
			close 1
			end
		endif
		e[le] = la[1]

		# The value is every token after the name. Most are a plain number,
		# but the warnings read WARNING_START + ERROR_x, so resolve each term
		# against the constants already collected instead of assuming the
		# last token is a number.
		v = 0
		sign = 1
		for i = 2 to la[?]-1
			t = la[i]
			if t <> "" then
				if t = "+" then
					sign = 1
				else
					if t = "-" then
						sign = -1
					else
						found = 0
						r = 0
						for j = 0 to le-1
							if e[j] = t then
								r = en[j]
								found = 1
							endif
						next j
						if found = 0 then r = int(t)
						v = v + sign * r
						sign = 1
					endif
				endif
			endif
		next i
		en[le] = v
		print le, e[le], en[le]

		# Message text: the line after "case <NAME>:" in Error.cpp. The colon
		# is part of the search so ERROR_SOUND does not match ERROR_SOUNDFILE.
		txt = ""
		open 2, base + "Error.cpp"
		while not eof(2)
			tl = readline(2)
			if instr(tl,"case ";la[1];":") then
				tl = readline(2)
				tl = explode(tl,'"')
				if tl[?] > 1 then txt = tl[1]
				exit while
			endif
		end while
		close 2
		et[le]= txt
		le = le + 1
	end if
end while
close 1

print
print le; " constants read."
print

# bubblesort alphabetically
for a = 0 to le-2
	for b = a+1 to le-1
		if e[b]<e[a] then
			x = e[a]
			e[a] = e[b]
			e[b] = x
			x = en[a]
			en[a] = en[b]
			en[b] = x
			x = et[a]
			et[a] = et[b]
			et[b] = x
		end if
	next b
next a


print "****************************************************************"
print "Pattern definitions for LEX/basicParse.l"
print "****************************************************************"
for t = 0 to le-1
	print lower(e[t]); ' ';
	for i = 1 to length(e[t])
		c = mid(e[t],i,1)
		print '[';
		if upper(c)=lower(c) then
			print c;
		else
			? upper(c);lower(c);
		endif
		print ']';
	next i
	print
next t

print "****************************************************************"
print "Pattern to terminal rules for LEX/basicParse.l"
print "****************************************************************"
for t = 0 to le-1
	print '{';lower(e[t]); '}';tab;tab;tab;
	print "{ count(); return B256";e[t];"; }";
	print
next t


print "****************************************************************"
print "Tokens for LEX/basicParse.y"
print "****************************************************************"
for t = 0 to le-1
	print "%token B256";e[t]
next t

print "****************************************************************"
print "Expression code for LEX/basicParse.y"
print "****************************************************************"
for t = 0 to le-1
	? "| B256"; e[t]; " args_none {"
	? tab; "addIntOp(OP_PUSHINT, "; e[t]; ");"
	? "}"
next t


print "****************************************************************"
print "Markdown table for the documentation site"
print "****************************************************************"
for t = 0 to le-1
	? "|"; e[t]; "|"; en[t];"|";et[t];"|"
next t


print "****************************************************************"
print "Lines for src/gui/EditSyntaxHighlighter.cpp"
print "****************************************************************"
for t = 0 to le-1
	? tab;tab;tab;'<<"'; e[t]; '"'
next t
