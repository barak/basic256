# Phase 1 spike - LOCATE, TEXTCOLOR, TEXTFONT in the text output pane.
# Columns and rows are zero based, like the graphics pane.

textfont "Consolas", 14

textcolor rgb(255,220,0), rgb(20,20,90)
locate 0, 0
print "  BASIC-256 RETRO TEXT  ";

textcolor rgb(160,160,160)
locate 0, 2
print "normal print still flows down the page,";
locate 0, 3
print "and LOCATE drops back in over the top of it.";

# draw a box by positioning, not by padding strings
textcolor rgb(0,255,128)
for r = 5 to 11
   locate 4, r
   print "|                            |";
next r
locate 4, 5
print "+----------------------------+";
locate 4, 11
print "+----------------------------+";

textcolor rgb(255,255,255), rgb(128,0,0)
locate 6, 7
print " overwrite, not insert ";

# a counter that rewrites one cell over and over
textcolor rgb(0,200,255)
for n = 1 to 40
   locate 10, 9
   print "tick "; n; "   ";
   pause .02
next n

textcolor rgb(120,0,160)
textfont "Segoe UI", 12, 700
locate 0, 13
print "TEXTFONT changes family, size and weight";
textfont ""
textcolor rgb(90,90,90)
print "and an empty family puts the pane font back.";

# INPUT lands wherever LOCATE left the cursor, and what is typed is
# echoed in the colour the program is printing in.
textcolor rgb(0,110,220)
locate 0, 15
print "enter your first name: ";
input name$

textcolor rgb(255,255,255), rgb(0,110,220)
locate 0, 18
print " Name: " + name$ + " ";

# TEXTCOL and TEXTROW report where the NEXT print will start. Reading them
# once a line has printed, and saying so on the row below, keeps the
# sentence from having to describe its own length.
textcolor rgb(90,90,90)
locate 0, 20
print "this line is measured after it has printed";
endcol = textcol
endrow = textrow
locate 0, 22
print "the line above ended at column " + string(endcol) + ", on row " + string(endrow);

pause 30
