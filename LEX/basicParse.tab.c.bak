	;}
    break;

  case 137:

    {
		addIntOp(OP_PUSHINT, ERROR_DBCOLNO);
	;}
    break;

  case 138:

    {
		addIntOp(OP_PUSHINT, ERROR_DBCONNNUMBER);
	;}
    break;

  case 139:

    {
		addIntOp(OP_PUSHINT, ERROR_DBNOTOPEN);
	;}
    break;

  case 140:

    {
		addIntOp(OP_PUSHINT, ERROR_DBNOTSET);
	;}
    break;

  case 141:

    {
		addIntOp(OP_PUSHINT, ERROR_DBNOTSETROW);
	;}
    break;

