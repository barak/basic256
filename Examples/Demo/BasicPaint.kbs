deltax_inc=2
call spinner(deltax_color, deltax_locx, deltax_locy, deltax_width, deltax_heigth, deltax_offsetx, deltax_offsety, deltax_insetx, deltax_insety, deltax_array, deltax_shown, deltax_max, deltax_min, deltax_inc)
deltax_up_x=sp_up_topleft_x
deltax_up_y=sp_up_topleft_y
deltax_down_x=sp_up_botright_x
deltax_down_y=sp_up_botright_y
deltax_updown_width=sp_heigth
deltax_updown_heigth=sp_heigth/2
# y-slant
deltay_color = 1
deltay_locx=220: deltay_locy=80
deltay_width=30: deltay_heigth=20
deltay_offsetx=8: deltay_offsety= 0
deltay_insetx=0.1: deltay_insety=0.1
# type specific (array or incremental)
deltay_array=0
deltay_min=-10
deltay_shown=4
deltay_max=10
deltay_inc=2
call spinner(deltay_color, deltay_locx, deltay_locy, deltay_width, deltay_heigth, deltay_offsetx, deltay_offsety, deltay_insetx, deltay_insety, deltay_array, deltay_shown, deltay_max, deltay_min, deltay_inc)
deltay_up_x=sp_up_topleft_x
deltay_up_y=sp_up_topleft_y
deltay_down_x=sp_up_botright_x
deltay_down_y=sp_up_botright_y
deltay_updown_width=sp_heigth
deltay_updown_heigth=sp_heigth/2
# draw Fake 3D checkbox
fake3d_1_elements=1
fake3d_1_locx=630
fake3d_1_locy_top=80 #top of first checkbox element
fake3d_1_locy_bot=80 #top of last checkbox element
check_label$[0]=fake3d_label_1$[0]
check_state[0]=fake3d_state_1[0]
call checkbox(fake3d_1_elements, fake3d_1_locx, fake3d_1_locy_top, fake3d_1_locy_bot)
return

# Line 0ptions
options_line:
spritehide 0
spritehide 1
color grey
rect 92,28,size_x-92-6,80
color black
font "Tahoma",8,100
text 98,35,"Options for the Line tool"
text 100,55,"Line thickness:"
#  text 290,50,"force hori."
#  text 290,75,"force vert."
text 550,30, "This is a line tool, drawing lines from"
text 550,50, "1 to 10 pixels wide in the color of your choice"
text 550,70, "You can constrain the line in the horizonal/vertical plane"
text 550,90, "There is also a 1-point perspective guideline option"
# linewidth spinner
slinew_color = 1
slinew_locx=200: slinew_locy=55
slinew_width=30: slinew_heigth=20
slinew_offsetx=8: slinew_offsety= 0
slinew_insetx=0.1: slinew_insety=0.1
# type specific (array or incremental)
slinew_array=0
slinew_min=1
slinew_shown=slinewidth
slinew_max=10
slinew_inc=1
call spinner(slinew_color,slinew_locx,slinew_locy, slinew_width, slinew_heigth, slinew_offsetx, slinew_offsety, slinew_insetx, slinew_insety, slinew_array, slinew_shown, slinew_max, slinew_min, slinew_inc)
slinew_up_x=sp_up_topleft_x
slinew_up_y=sp_up_topleft_y
slinew_down_x=sp_up_botright_x
slinew_down_y=sp_up_botright_y
slinew_updown_width=sp_heigth
slinew_updown_heigth=sp_heigth/2
# Horizontal lock
Loc_hori_1_elements=1
Loc_hori_1_locx=290
Loc_hori_1_locy_top=50 #top of first checkbox element
Loc_hori_1_locy_bot=50 #top of last checkbox element
check_label$[0]=Loc_hori_label_1$[0]
check_state[0]=Loc_hori_state_1[0]
Loc_hori_state=Loc_hori_state_1[0]
call checkbox(Loc_hori_1_elements, Loc_hori_1_locx, Loc_hori_1_locy_top, Loc_hori_1_locy_bot)
# Vertical lock
Loc_vert_1_elements=1
Loc_vert_1_locx=290
Loc_vert_1_locy_top=75 #top of first checkbox element
Loc_vert_1_locy_bot=75 #top of last checkbox element
check_label$[0]=Loc_vert_label_1$[0]
check_state[0]=Loc_vert_state_1[0]
Loc_vert_state=Loc_vert_state_1[0]
call checkbox(Loc_vert_1_elements, Loc_vert_1_locx, Loc_vert_1_locy_top, Loc_vert_1_locy_bot)
# One-Point perspective starburst
Perspective_elements=1
Perspective_locx=400
Perspective_locy_top=50 #top of first checkbox element
Perspective_locy_bot=50 #top of last checkbox element
check_label$[0]=Perspective_label_1$[0]
check_state[0]=Perspective_state_1[0]
Perspective_state=0
call checkbox(Perspective_elements, Perspective_locx, Perspective_locy_top, Perspective_locy_bot)
color black
font "Tahoma",8,100
text 420,65,"(starburst)"
# One-Point perspective starburst - ground only option
PerspecGround_elements=1
PerspecGround_locx=430
PerspecGround_locy_top=80 #top of first checkbox element
PerspecGround_locy_bot=80 #top of last checkbox element
check_label$[0]=PerspecGround_label_1$[0]
check_state[0]=PerspecGround_state_1[0]
if PerspecGround_state=1 then
	call checkbox(PerspecGround_elements, PerspecGround_locx, PerspecGround_locy_top, PerspecGround_locy_bot)
endif
return

