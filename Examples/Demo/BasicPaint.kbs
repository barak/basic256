color grey
rect 92,28,size_x-92-6,80
color black
font "Tahoma",8,100
text 98,35,"Options for Pen:"
text 170,45,"X slant:"
text 170,85,"Y slant:"
text 350,45,": X slant on 0"
text 350,80,": Y slant on 0"
text 470,45,": X slant and Y slant opposite"
text 470,80,": X & Y slant both same"
rect 330,43,2,17
rect 322,84,16,2
#  line 453,43,438,58
#  line 454,43,439,58
line 438,43,453,58
line 439,43,454,58
line 453,80,438,95
line 454,80,439,95
# X-slant
deltax_color = 1
deltax_locx=220: deltax_locy=40
deltax_width=30: deltax_heigth=20
deltax_offsetx=8: deltax_offsety= 0
deltax_insetx=0.1: deltax_insety=0.1
# type specific (array or incremental)
