#*********************************
#  Color Selector code
#*********************************
colorpick:
sw_colors=1
spritehide 2
imgsave "bpaintundo.png"   # kept: colorpick window save
spriteshow 2
#screen draw
fromright=165
offsetx=10
offsety=size_y-320 # offset for big color area
#color picker 'window'
b_init=0
b_locx=fromright
b_locy=size_y-335
b_width=330
b_height= 250
b_text$=" "
b_textsize=8
b_offsetx=0
b_offsety=0
call button(b_locx, b_locy, b_width, b_height, b_text$, b_textsize, b_offsetx, b_offsety, b_init)
# color picker color area
draw_elements_x=1
draw_elements_y=1
draw_locx=fromright+offsetx
draw_locy=offsety
draw_width=180
draw_height=180
draw_offsetx=0
draw_offsety=0
draw_color=0
call drawing(draw_elements_x, draw_elements_y, draw_locx, draw_locy, draw_width,draw_height, draw_offsetx, draw_offsety, draw_color)
# current color square
draw_elements_x=1
draw_elements_y=1
draw_locx=fromright+250
draw_locy=offsety
draw_width=40
draw_height=40
draw_offsetx=0
draw_offsety=0
draw_color=0
call drawing(draw_elements_x, draw_elements_y, draw_locx, draw_locy, draw_width,draw_height, draw_offsetx, draw_offsety, draw_color)
# current color components
font "Tahoma",8,100
color black
text fromright+235,offsety+70,"red  :"
text fromright+235,offsety+90,"green:"
text fromright+235,offsety+110,"blue :"
rood=255:groen=0:blauw=0
color rgb(rood,groen,blauw)
rect fromright+250,offsety,40,40
draw_elements_x=1
draw_elements_y=3
draw_locx=fromright+280
draw_locy=offsety+70
draw_width=30
draw_height=12
draw_offsetx=0
draw_offsety=0
draw_color=0
call drawing(draw_elements_x, draw_elements_y, draw_locx, draw_locy, draw_width,draw_height, draw_offsetx, draw_offsety, draw_color)
color black
text fromright+285,offsety+70,rood
text fromright+285,offsety+90,groen
text fromright+285,offsety+110,blauw
refresh
#color picker 'OK' button
b_init=0
b_locx=fromright+240
b_locy=size_y-335+170
b_width=60
b_height= 20
b_text$="OK"
b_textsize=8
b_offsetx=22
b_offsety=3
call button(b_locx, b_locy, b_width, b_height, b_text$, b_textsize, b_offsetx, b_offsety, b_init)

#color picker 'Save as Custom' button
b_init=0
b_locx=fromright+225
b_locy=size_y-335+200
b_width=90
b_height= 20
b_text$="Save Custom"
b_textsize=8
b_offsetx=4
b_offsety=3
call button(b_locx, b_locy, b_width, b_height, b_text$, b_textsize, b_offsetx, b_offsety, b_init)

# fill color picker color area
colmax=255
init=0
incr=colmax/30
for j=0 to 180
	rood=colmax
	groen=init
	blauw=init
	sw_red=0
	for i = 0 to 180
		color rgb(rood, groen, blauw)
		plot fromright+offsetx+i,offsety+j
		if rood = colmax and blauw= init then groen=groen+incr
		if groen >colmax -1 or groen = colmax then
			groen = colmax
			rood=rood-incr
		endif
		if rood <= incr and groen >= colmax-1 then blauw=blauw+incr
		if blauw >= colmax and groen >init and  rood<=init then
			groen = groen -incr
		endif
		if blauw >=colmax and groen <=init then
			rood = rood +incr
		endif
		if blauw >=colmax and groen <=init and rood >= colmax then
			sw_red=1
		endif
		if sw_red=1 then blauw = blauw-incr
		if groen > colmax then groen = colmax
		if groen <init then groen = init
		if rood > colmax then rood = colmax
		if rood <init then rood = init
		if blauw > colmax then blauw = colmax
		if blauw <init then blauw = init
	next i
next j

#fade to grey and white to black
orood=255:ogroen=0:oblauw=0
gosub fadetogrey
gosub whitetoblack

# stamps for sliders
color black
dim triwb(6)
dim trigrey(6)
triwb = {4, 0, 4, 8, 0, 4}
trig = {4, 0, 8, 4, 0, 4}
# stamp the triangle at 0,0 (full size)
stamp fromright+219, 90+offsety, triwb
stamp fromright+offsetx, 209+offsety, trig
refresh

#now comes the code
# [removed debug print]
while 1=1
	# in main color area
	while mouseb> 0 and mousex>fromright+offsetx and mousey>offsety and mousex< fromright+offsetx+180 and mousey< offsety+180
		fullcolor= pixel(mousex, mousey)
		rood= rood(fullcolor)
		groen = groen(fullcolor)
		blauw= blauw(fullcolor)
		color grey
		rect fromright+offsetx,209+offsety,200, 5
		rect fromright+219,offsety-10, 5,200
		color black
		stamp fromright+219, 90+offsety, triwb
		stamp fromright+offsetx, 209+offsety, trig
		if rood>255 then rood=255
		if groen>255 then groen=255
		if blauw>255 then blauw=255
		if rood<0 then rood=0
		if groen<0 then groen=0
		if blauw<0 then blauw=0
		color rgb(rood, groen, blauw)
		rect fromright+250,offsety,40,40
		color white
		rect  fromright+280,offsety+70,30,12
		rect  fromright+280,offsety+90,30,12
		rect  fromright+280,offsety+110,30,12
		color black
		text fromright+285,offsety+70,rood
		text fromright+285,offsety+90,groen
		text fromright+285,offsety+110,blauw
		gosub fadetogrey
		gosub whitetoblack
		refresh
	end while
	#in white to black slider
	while  mousex>fromright+217 and mousey>offsety and mousex< fromright+224 and mousey< offsety+180
		while mouseb> 0 and mousey>offsety and mousey< offsety+180
			fullcolor= pixel(fromright+215, mousey)
			rood= rood(fullcolor)
			groen = groen(fullcolor)
			blauw= blauw(fullcolor)
			gosub fadetogrey
			if rood>255 then rood=255
			if groen>255 then groen=255
			if blauw>255 then blauw=255
			if rood<0 then rood=0
			if groen<0 then groen=0
			if blauw<0 then blauw=0
			color rgb(rood, groen, blauw)
			rect fromright+250,offsety,40,40
			color grey
			rect 219+fromright,offsety-10, 5,200
			color black
			stamp 219+fromright, mousey-3, triwb
			color white
			rect  fromright+280,offsety+70,30,12
			rect  fromright+280,offsety+90,30,12
			rect  fromright+280,offsety+110,30,12
			color black
			text fromright+285,offsety+70,rood
			text fromright+285,offsety+90,groen
			text fromright+285,offsety+110,blauw
			refresh
		end while
	end while
	#in grey slider
	while  mousex>fromright+offsetx and mousey>offsety+207 and mousex< fromright+190 and mousey< offsety+214
		while mouseb> 0 and mousex>fromright+offsetx and mousex< fromright+190
			fullcolor= pixel(mousex, offsety+203)
			rood= rood(fullcolor)
			groen = groen(fullcolor)
			blauw= blauw(fullcolor)
			gosub whitetoblack
			if rood>255 then rood=255
			if groen>255 then groen=255
			if blauw>255 then blauw=255
			if rood<0 then rood=0
			if groen<0 then groen=0
			if blauw<0 then blauw=0
			color rgb(rood, groen, blauw)
			rect fromright+250,offsety,40,40
			color grey
			rect fromright+5,209+offsety,200, 5
			color black
			if mousex> fromright+7 then
				stamp mousex-3, 209+offsety,  trig
			else
				stamp fromright+7, 209+offsety,  trig
			endif
			color white
			rect  fromright+280,offsety+70,30,12
			rect  fromright+280,offsety+90,30,12
			rect  fromright+280,offsety+110,30,12
			color black
			text fromright+285,offsety+70,rood
			text fromright+285,offsety+90,groen
			text fromright+285,offsety+110,blauw
			refresh
		end while
	end while
	#on the OK button
	while  sw_colors=1 and mouseb>0 and mousex>fromright+240 and mousey>size_y-335+170 and mousex< fromright+300 and mousey< size_y-335+190
		sw_colors=0
		b_init=2
		b_locx=fromright+240
		b_locy=size_y-335+170
		b_width=60
		b_height= 20
		b_text$="OK"
		b_textsize=8
		b_offsetx=22
		b_offsety=3
		call button(b_locx, b_locy, b_width, b_height, b_text$, b_textsize, b_offsetx, b_offsety, b_init)
		imgload size_x/2,size_y/2,"bpaintundo.png"
		spriteshow 2
		colorid=rgb(rood, groen, blauw)
		draw2_color = 2
		call drawing(draw2_elements_x, draw2_elements_y, draw2_locx, draw2_locy, draw2_width,draw2_height, draw2_offsetx, draw2_offsety, draw2_color)
		color colorid
		rect draw2_locx,draw2_locy,draw2_width,draw2_height
		if custcol > -1 then
			for i = 0 to 9
				if custcols[i] <> 0 then
					color custcols[i]
				else
					color white
				endif
				if i < 5 then
					rect 420+i*28,size_y-59,15,15
				else
					rect 420+(i-5)*28,size_y-31,15,15
				end if
			next i
			refresh
		end if
		return
	end while
	#on the Save Custom button
	while  sw_colors=1 and mouseb>0 and mousex>fromright+225 and mousey>size_y-335+200 and mousex< fromright+315 and mousey< size_y-335+220
		b_init=2
		b_locx=fromright+225
		b_locy=size_y-335+200
		b_width=90
		b_height= 20
		b_text$="Save Custom"
		b_textsize=8
		b_offsetx=4
		b_offsety=3
		call button(b_locx, b_locy, b_width, b_height, b_text$, b_textsize, b_offsetx, b_offsety, b_init)
		colorid=rgb(rood, groen, blauw)
		draw2_color = 2
		call drawing(draw2_elements_x, draw2_elements_y, draw2_locx, draw2_locy, draw2_width,draw2_height, draw2_offsetx, draw2_offsety, draw2_color)
		color colorid
		rect draw2_locx,draw2_locy,draw2_width,draw2_height
		custcol=custcol+1
		if custcol>9 then custcol=0
		custcols[custcol]=colorid
		if custcol>4 then
			custcolrow=2
		else
			custcolrow=1
		endif
		if custcolrow=1 then
			rect 420+custcol*28,size_y-59,15,15
		else
			rect 420+(custcol-5)*28,size_y-31,15,15
		endif
		custcols[custcol]=colorid
		refresh
		pause 0.2
	end while
end while
return

fadetogrey:
#fade togrey
grood=rood:ggroen=groen:gblauw=blauw
grinc=(grood-128)/180
gginc=(ggroen-128)/180
gbinc=(gblauw-128)/180
for i = 0 to 180
	grood=grood-grinc
	ggroen=ggroen-gginc
	gblauw=gblauw-gbinc
	if grood>255 then grood=255
	if ggroen>255 then ggroen=255
	if gblauw>255 then gblauw=255
	if grood<0 then grood=0
	if ggroen<0 then ggroen=0
	if gblauw<0 then gblauw=0
	color rgb(grood, ggroen, gblauw)
	line fromright+offsetx+i,200+offsety,fromright+offsetx+i,205+offsety
next i
return

whitetoblack:
#white to black
urood=rood:ugroen=groen:ublauw=blauw
urinc=(255-urood)/90
uginc=(255-ugroen)/90
ubinc=(255-ublauw)/90
for j = 90 to 1 step -1
	urood=urood+urinc
	ugroen=ugroen+ uginc
	ublauw=ublauw+ ubinc
	if urood>255 then urood=255
	if ugroen>255 then ugroen=255
	if ublauw>255 then ublauw=255
	if urood<0 then urood=0
	if ugroen<0 then ugroen=0
	if ublauw<0 then ublauw=0
	color rgb(urood, ugroen, ublauw)
	line fromright+210,j+offsety,fromright+215,j+offsety
next j
drood=rood:dgroen=groen:dblauw=blauw
drinc=drood/90
dginc=dgroen/90
dbinc=dblauw/90
for j=91 to 180
	drood=drood- drinc
	dgroen=dgroen- dginc
	dblauw=dblauw- dbinc
	if drood>255 then drood=255
	if dgroen>255 then dgroen=255
	if dblauw>255 then dblauw=255
	if drood<0 then drood=0
	if dgroen<0 then dgroen=0
	if dblauw<0 then dblauw=0
	color rgb(drood, dgroen, dblauw)
	line fromright+210,j+offsety,fromright+215,j+offsety
next j
return

#*****************
# Program end
#*****************
alldone:
graphsize (300,200)
color white
rect 0,0, 300,200
color black
rect 0,0,300,4
rect 0,196,300,200
rect 0,0,4,200
rect 296,0,300,200
font "Tahoma",12,100
text 15,70,"Thanks for trying out Basic Paint!"
font "Tahoma",8,100
text 70,120,"  "
refresh
editvisible 1
outputvisible 1
end
return

#**********************
# Program save and end
#**********************
savequit:
spritehide 2
imgsave "bpaintundo.png"   # kept: savequit file export
spriteshow 2
color grey
font "Tahoma",14,100
text size_x/2-60,size_y/2-15,"Please wait"
refresh
graphsize (size_x-84,size_y-179)
color red
rect 0,0, size_x-84,size_y-177
imgload (size_x-155)/2,(size_y-221)/2, "bpaintundo.png"
h = hour
if h > 12 then h = h - 12
if h = 0 then h = 12
timestamp$= right("0" + h, 2) + "-" + right("0" + minute, 2) + "-" + right("0" + second, 2)
savefile$="MyBasicPainting-"+timestamp$+".png"
imgsave savefile$
graphsize (size_x,size_y)
sw_title=1
gosub draw_interface
return

clearbutton:
#look at action$ and call correct button with b_init=0
for i = 0 to 5
	if tools$[i]=action$ then
		loc=i
		i=10
	endif
next i
if toolloc[loc*2+1]=1 then
	startposx=8
else
	startposx=42
endif
startposy=109+(toolloc[loc*2]-1)*35
call button (startposx,startposy,32,32," ",8,6,11,0)
gosub drawpencil
gosub drawspray
gosub drawerase
gosub drawfill
gosub drawcolpic
gosub drawpen
gosub drawcirc
gosub drawrecta
gosub drawline
gosub drawpoly
gosub drawbezier
gosub drawbackgrd
refresh
return

pushbutton:
#look at action$ and call correct button with b_init=1
redraw$="draw"+action$
for i = 0 to 11
	if tools$[i]=action$ then
		loc=i
		i=12
	endif
next i
if toolloc[loc*2+1]=1 then
	startposx=8
else
	startposx=42
endif
startposy=109+(toolloc[loc*2]-1)*35
call button (startposx,startposy,32,32," ",8,6,11,1)
refresh
return


