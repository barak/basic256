#************************************************************************************************
#*      Part 3: Verlet integration for colliding balls of different mass Balls                  *
#************************************************************************************************
# Particle system with gravity, bounce, a bit of friction and Balls of different mass/size
# Balls collide and bounce of each other according to their mass
# Verlet integration has no explicit velocity defined. Velocity is derived from previous position
#************************************************************************************************
# Definitions
#************************************************************************************************
#Globals to be used in the subroutines
global height, width, pos_x, pos_y, old_pos_x, old_pos_y
global rad, inv_mass, bounce, gravity, friction
global r, g, b, Balls, Ball,sw_fall
# Initialisations
#************************************************************************************************
call ScreenSetup()		#dimension & color
call WorldParameters()	#gravity, friction/drag, elasticity
call CreateBalls()	    #location, old location, color, radius and derived mass

# Drawing loop
#************************************************************************************************
while true
	call UpdateBalls()
	call DrawBalls()
end while

#here begin the subroutines
#************************************************************************************************
subroutine ScreenSetup()
	fastgraphics
	width = 1000: height = 1000
	graphsize width, height
	color black
	rect 0,0,width,height
	editvisible 0
	outputvisible 0
	refresh
end subroutine

subroutine WorldParameters()
	bounce = 0.5
	gravity = 0.5
	friction = 0.9999
	sw_fall = 0
end subroutine

subroutine CreateBalls()
	Balls = 150
	dim Ball(Balls,9)
	StartRad =10
	Max_inc = 15
	# Indices
	pos_x = 0 : pos_y = 1: old_pos_x = 2 : old_pos_y = 3: r = 4 : g = 5 : b = 6: rad = 7 : inv_mass = 8
	for i = 0 to Balls-1
		Ball[i,pos_x] = rand*width
		Ball[i,pos_y] = rand*height/2
		Ball[i,old_pos_x] = Ball[i,pos_x] - (rand*10 - 5)
		Ball[i,old_pos_y] = Ball[i,pos_y] - (rand*10 - 5)
		Ball[i,r] = 50 + (rand*155)
		Ball[i,g] = 50 + (rand*155)
		Ball[i,b] = 50 + (rand*155)
		Ball[i,rad] = StartRad + rand*Max_inc
		# Store inverse mass (1/mass) where mass = rad^2
		Ball[i,inv_mass] = 1 / (Ball[i,rad] * Ball[i,rad])
	next i
	call DrawBalls()
	call DrawScene()
	call WaitEnter()
end subroutine

subroutine UpdateBalls()
	k = key
	if k = asc("Q") or k = asc("q") or k = 16777216 then end
	if k = 13 or k = 16777220 or k = 16777221 or clickb = 1 then 
		clickclear
		pause 0.2
		call CreateBalls()
	endif	
	sw_fall = 1
	# Here is the actual Verlet integration. With collisions in the mix, the max number of balls for a real-time animation decreases dramatically
	for i = 0 to Balls-1
		vx = (Ball[i,pos_x] - Ball[i,old_pos_x]) * friction
		vy = (Ball[i,pos_y] - Ball[i,old_pos_y]) * friction
		Ball[i,old_pos_x] = Ball[i,pos_x]
		Ball[i,old_pos_y] = Ball[i,pos_y]
		Ball[i,pos_x] = Ball[i,pos_x] + vx
		Ball[i,pos_y] = Ball[i,pos_y] + vy + gravity
	next i
	color white
	font "Arial", 20, 50
	text 12, 22, "[Enter] or touch re-drop     [Q] quit"
	#---------------------------------------------------------------------------------------------
	# Multiple collision passes are needed as one collision can create another one with a neighbouring ball.
	#---------------------------------------------------------------------------------------------
	for iter = 1 to 3
		# Ball-Ball Collisions
		for i = 0 to Balls-1
			for j = i + 1 to Balls - 1
				dx = Ball[i,pos_x] - Ball[j,pos_x]
				dy = Ball[i,pos_y] - Ball[j,pos_y]
				distance = sqr(dx * dx + dy * dy)
				SumRad = Ball[i,rad] + Ball[j,rad]
				if (distance < SumRad) and (distance > 0) then
					nx = dx / distance
					ny = dy / distance
					overlap = SumRad - distance
					# Inverse mass weighting: heavier moves less
					w1 = Ball[i,inv_mass]
					w2 = Ball[j,inv_mass]
					wsum = w1 + w2

					if wsum > 0 then
						push = overlap / wsum
						# Push ball i away along normal
						Ball[i,pos_x] = Ball[i,pos_x] + nx * push * w1
						Ball[i,pos_y] = Ball[i,pos_y] + ny * push * w1
						# Push ball j opposite direction along normal
						Ball[j,pos_x] = Ball[j,pos_x] - nx * push * w2
						Ball[j,pos_y] = Ball[j,pos_y] - ny * push * w2
					end if
				end if
			next j
		next i

		# Boundary Constraints
		for i = 0 to Balls-1
			# Recalculate current velocity after positional adjustments
			vx = Ball[i,pos_x] - Ball[i,old_pos_x]
			vy = Ball[i,pos_y] - Ball[i,old_pos_y]

			if Ball[i,pos_x] > width - Ball[i,rad] then
				Ball[i,pos_x] = width - Ball[i,rad]
				Ball[i,old_pos_x] = Ball[i,pos_x] + vx * bounce
			else
				if Ball[i,pos_x] < Ball[i,rad] then
					Ball[i,pos_x] = Ball[i,rad]
					Ball[i,old_pos_x] = Ball[i,pos_x] + vx * bounce
				endif
			endif

			if Ball[i,pos_y] > height - Ball[i,rad] then
				Ball[i,pos_y] = height - Ball[i,rad]
				Ball[i,old_pos_y] = Ball[i,pos_y] + vy * bounce
			else
				if Ball[i,pos_y] < Ball[i,rad] then
					Ball[i,pos_y] = Ball[i,rad]
					Ball[i,old_pos_y] = Ball[i,pos_y] + vy * bounce
				endif
			endif
		next i
	next iter
end subroutine

subroutine DrawBalls()
	color black
	rect 0, 0, width, height
	for i = 0 to Balls-1
		color rgb(Ball[i,r], Ball[i,g], Ball[i,b])
		circle (Ball[i,pos_x], Ball[i,pos_y], Ball[i,rad])
	next i
	color white
	font "Arial", 20, 50
	if sw_fall = 1 then text 12, 22, "[Enter] or touch re-drop     [Q] quit"
	refresh
end subroutine

subroutine DrawScene()
	if sw_fall = 0 then
		color white
		font "Arial", 40, 75
		tx = (width - textwidth("VERLET BALLS")) / 2    # true centre for this font
		ty = height / 2 +50
		color rgb(30, 30, 255)
		text tx, ty, "VERLET BALLS"
		color white
		font "Arial", 20, 50
		tx = (width - textwidth("Press [Enter] to start or touch screen, [Q] to quit")) / 2    # true centre for this font
		ty = height / 2
		color white
		text tx, ty+125, "Press [Enter] to start or touch screen, [Q] to quit"
		refresh
	endif
end subroutine

subroutine WaitEnter()
	do
		k = key
		pause 0.01
	until k = 13 or k = 16777220 or k = 16777221 or mouseb = 1
end subroutine