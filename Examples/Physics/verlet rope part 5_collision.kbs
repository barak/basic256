#**********************************************************************************************
#*                Part 5: Verlet integration for a chain/rope                                 *
#**********************************************************************************************
# A verlet integration with each particle connected to the previous one forming a chain
# The world also has gravity, bounce and some friction
# The first particle is 'pinned' so gravity has no effect unless moved by the mouse.
# Moving the pinned particle makes the rope move realistically and collide with the walls.
# Sticks are of a fixed length (ie the initial distance between the pairs of particles)
# Verlet integration has no explicit velocity defined. Velocity is derived from previous position
#************************************************************************************************
#Globals to be used in the subroutines
#************************************************************************************************
global height, width, pos_x, pos_y, old_pos_x, old_pos_y ,pinned
global radius, bounce, gravity, friction, grab
global r, g, b, Particles, Part, Sticks, Stick, dist, long, particle1, particle2
global collisionObject1, collisionObject2
# Self-collision parameters
#**********************************************************************************************
# Particles are treated as circles with diameter radius * 2.
# Direct neighbours are excluded because they are already connected by a stick.

# Initialisations
#************************************************************************************************
call ScreenSetup()
call WorldParameters()
call CreateParticles()
call CreateSticks()
# Drawing loop
#**********************************************************************************************
while true
	call mousedrag(mousex,mousey,mouseb)
	call UpdateParticles()
	call UpdateSticks()
#	call SelfCollisions()
	call BoundaryCollisions()
	call ObjectCollision()
	call DrawParticles()
	call DrawSticks()
	font "arial", 18,100
	text1 = textwidth ("Vertlet Rope Collision Demo")
	offset1 = (width - text1)/2
	text2 = textwidth ("Move the red dot with the mouse")
	offset2 = (width - text2)/2
	text offset1,20,"Vertlet Rope Collision Demo"	
	text offset2,50,"Move the red dot with the mouse"	
	refresh
	pause 0.01
end while

#here begin the subroutines
#**********************************************************************************************
subroutine ScreenSetup()
	fastgraphics
	editvisible 0
	outputvisible 0
	Graphvisible 1
	width = 800: height = 800
	graphsize width, height
	cls : clg white
	refresh
end subroutine

subroutine WorldParameters()
	# Physics
	bounce = 0.6
	gravity = 0.5
	friction = 0.999
	grab = -1
end subroutine

subroutine CreateParticles()
	dim collisionObject1(1,2)
	dim collisionObject2(1,2)
	collisionObject1[0,0] = width/3
	collisionObject1[0,1] = height/2
	collisionObject2[0,0] = 2*width/3
	collisionObject2[0,1] = height/2
	Particles = 60
	dim Part(Particles,5)
	radius = 3
	dist = 10
	pos_x = 0: pos_y = 1: old_pos_x = 2: old_pos_y = 3: pinned = 4
	for i = 0 to Particles-1
		Part[i,pos_x] = width/2
		Part[i,pos_y] = 100 + dist*i
		Part[i,old_pos_x] = width/2
		Part[i,old_pos_y] = 100 + dist*i
		if i = 0 then Part[i,pinned] = 1
	next i
end subroutine

subroutine CreateSticks()
	particle1 = 0
	particle2 = 1
	long = 2
	Sticks = Particles - 1
	dim Stick(Sticks, 3)
	for i = 0 to Sticks - 1
		# Connect particle 'i' directly to particle 'i + 1'
		Stick[i, particle1] = i
		Stick[i, particle2] = i + 1
		a = Stick[i, particle1]
		b = Stick[i, particle2]
		dx = Part[b, pos_x] - Part[a, pos_x]
		dy = Part[b, pos_y] - Part[a, pos_y]
		# Store the initial distance as the target length of the stick
		Stick[i, long] = sqr(dx * dx + dy * dy)
	next i
end subroutine


subroutine UpdateParticles()
	for i = 0 to Particles-1
		if Part[i,pinned] < 1 then
			vx = (Part[i,pos_x]-Part[i,old_pos_x]) * friction
			vy = (Part[i,pos_y]-Part[i,old_pos_y]) * friction
			Part[i,old_pos_x] = Part[i,pos_x]
			Part[i,old_pos_y] = Part[i,pos_y]
			Part[i,pos_x] = Part[i,pos_x] + vx
			Part[i,pos_y] = Part[i,pos_y] + vy + gravity
		endif
	next i
end subroutine

subroutine UpdateSticks()
	for iteration = 1 to 20
		call SelfCollisions()	
	next iteration
	for iteration = 1 to 60
		if iteration mod 2 = 0 then
			# even passes: sweep pinned end -> free end
			for i = 0 to Sticks - 1
				call SolveStick(i)
			next i
		else
			# odd passes: sweep free end -> pinned end
			for i = Sticks - 1 to 0 step -1
				call SolveStick(i)
			next i
		endif
	next iteration
end subroutine

subroutine SolveStick(i)
	a = Stick[i, particle1]
	b = Stick[i, particle2]
	dx = Part[b, pos_x] - Part[a, pos_x]
	dy = Part[b, pos_y] - Part[a, pos_y]
	distance = sqr(dx * dx + dy * dy)
	if distance > 0 then
		difference = Stick[i, long] - distance
		percent = difference / distance
		offsetX = dx * percent
		offsetY = dy * percent
		a_pinned = Part[a, pinned]
		b_pinned = Part[b, pinned]
		if a_pinned < 1 and b_pinned < 1 then
			Part[a, pos_x] = Part[a, pos_x] - offsetX * 0.5
			Part[a, pos_y] = Part[a, pos_y] - offsetY * 0.5
			Part[b, pos_x] = Part[b, pos_x] + offsetX * 0.5
			Part[b, pos_y] = Part[b, pos_y] + offsetY * 0.5
		else
			if a_pinned >= 1 and b_pinned < 1 then
				Part[b, pos_x] = Part[b, pos_x] + offsetX
				Part[b, pos_y] = Part[b, pos_y] + offsetY
			else
				if a_pinned < 1 and b_pinned >= 1 then
					Part[a, pos_x] = Part[a, pos_x] - offsetX
					Part[a, pos_y] = Part[a, pos_y] - offsetY
				endif
			endif
		endif
	endif
end subroutine

subroutine SelfCollisions()
	# Resolve collisions between non-neighbouring particles.
	# A particle is considered colliding when the distance between their
	# centres is less than two radii.
	collisionDistance = radius * 2

	for a = 0 to Particles - 2
		for b = a + 1 to Particles - 1
			# Adjacent particles already have a stick constraint.
			# Do not let self-collision fight that constraint.
			if b > a + 1 then
				dx = Part[b,pos_x] - Part[a,pos_x]
				dy = Part[b,pos_y] - Part[a,pos_y]
				distanceSquared = dx * dx + dy * dy

				if distanceSquared < collisionDistance * collisionDistance then
					distance = sqr(distanceSquared)

					# Avoid division by zero if two particles have exactly
					# the same position. Give the collision a small direction.
					if distance < 0.0001 then
						dx = collisionDistance
						dy = 0
						distance = collisionDistance
					endif

					# Amount by which the particles overlap.
					overlap = collisionDistance - distance
					nx = dx / distance
					ny = dy / distance

					a_pinned = Part[a,pinned]
					b_pinned = Part[b,pinned]

					if a_pinned < 1 and b_pinned < 1 then
						# Both particles are free: split the correction.
						Part[a,pos_x] = Part[a,pos_x] - nx * overlap * 0.5
						Part[a,pos_y] = Part[a,pos_y] - ny * overlap * 0.5
						Part[b,pos_x] = Part[b,pos_x] + nx * overlap * 0.5
						Part[b,pos_y] = Part[b,pos_y] + ny * overlap * 0.5
					else
						if a_pinned >= 1 and b_pinned < 1 then
							# A is fixed: move B completely out of A.
							Part[b,pos_x] = Part[b,pos_x] + nx * overlap
							Part[b,pos_y] = Part[b,pos_y] + ny * overlap
						else
							if a_pinned < 1 and b_pinned >= 1 then
								# B is fixed: move A completely out of B.
								Part[a,pos_x] = Part[a,pos_x] - nx * overlap
								Part[a,pos_y] = Part[a,pos_y] - ny * overlap
							endif
						endif
					endif
				endif
			endif
		next b
	next a
end subroutine

subroutine BoundaryCollisions()
	for i = 0 to Particles-1
		if Part[i,pos_x] > width-radius then
			vx = Part[i,pos_x]-Part[i,old_pos_x]
			Part[i,pos_x] = width-radius
			Part[i,old_pos_x] = Part[i,pos_x]+vx*bounce
		else
			if Part[i,pos_x] < radius then
				vx = Part[i,pos_x]-Part[i,old_pos_x]
				Part[i,pos_x] = radius
				Part[i,old_pos_x] = Part[i,pos_x]+vx*bounce
			endif
		endif
		if Part[i,pos_y] > height-radius then
			vy = Part[i,pos_y]-Part[i,old_pos_y]
			Part[i,pos_y] = height-radius
			Part[i,old_pos_y] = Part[i,pos_y]+vy*bounce
		else
			if Part[i,pos_y] < radius then
				vy = Part[i,pos_y]-Part[i,old_pos_y]
				Part[i,pos_y] = radius
				Part[i,old_pos_y] = Part[i,pos_y]+vy*bounce
			endif
		endif
	next i
end subroutine

subroutine ObjectCollision()
# Radius matching the drawn circles (50) plus particle radius
	objRadius = 50 + radius

	for i = 0 to Particles - 1
		if Part[i, pinned] < 1 then
			# --- Collision with collisionObject1 ---
			dx1 = Part[i, pos_x] - collisionObject1[0, 0]
			dy1 = Part[i, pos_y] - collisionObject1[0, 1]
			distSq1 = dx1 * dx1 + dy1 * dy1

			if distSq1 < objRadius * objRadius then
				dist1 = sqr(distSq1)
				if dist1 < 0.0001 then dist1 = 0.0001
				nx = dx1 / dist1
				ny = dy1 / dist1
				
				# Push particle outside the object boundary
				Part[i, pos_x] = collisionObject1[0, 0] + nx * objRadius
				Part[i, pos_y] = collisionObject1[0, 1] + ny * objRadius
			endif

			# --- Collision with collisionObject2 ---
			dx2 = Part[i, pos_x] - collisionObject2[0, 0]
			dy2 = Part[i, pos_y] - collisionObject2[0, 1]
			distSq2 = dx2 * dx2 + dy2 * dy2

			if distSq2 < objRadius * objRadius then
				dist2 = sqr(distSq2)
				if dist2 < 0.0001 then dist2 = 0.0001
				nx = dx2 / dist2
				ny = dy2 / dist2

				# Push particle outside the object boundary
				Part[i, pos_x] = collisionObject2[0, 0] + nx * objRadius
				Part[i, pos_y] = collisionObject2[0, 1] + ny * objRadius
			endif
		endif
	next i
end subroutine

subroutine DrawParticles()
	color white
	rect 0, 0, width, height
	color black
	circle collisionObject1[0,0],collisionObject1[0,1],50
	circle collisionObject2[0,0],collisionObject1[0,1],50
	for i = 0 to Particles-1
		if Part[i,pinned] = 1 then
			color red
			circle (Part[i,pos_x], Part[i,pos_y], radius)
		else
			color blue
			circle (Part[i,pos_x], Part[i,pos_y],4)
#			circle Part[i,pos_x], Part[i,pos_y],radius
		endif
	next i
end subroutine

subroutine DrawSticks()
	for i = 0 to Sticks-1
		a = Stick[i,particle1]
		b = Stick[i,particle2]
		penwidth 2
		color black
		line (Part[a,pos_x],Part[a,pos_y], Part[b,pos_x],Part[b,pos_y])
	next i
end subroutine

subroutine mousedrag(mx, my, mb)
 	if mx < 0 then return                 # pointer left the window
	if mb & 1 then                        # left button held (bit 1)
		if grab = -1 then
			# grab the nearest free ball within reach / its radius
			best = -1 : bestd = 1000000000
			for i = 0 to Particles - 1
				if Part[i,pinned] = 1 then
					thr = radius*radius
					dx = Part[i,pos_x] - mx : dy = Part[i,pos_y] - my
					dd = dx * dx + dy * dy
					if dd < thr * thr then
						if dd < bestd then bestd = dd : best = i
					end if
				end if
			next i
			if best >= 0 then
				grab = best
				Part[grab,pinned] = 1            # freeze while held
				Part[grab,pos_x] = mx : Part[grab,pos_y] = my
				Part[grab,old_pos_x] = mx : Part[grab,old_pos_y] = my
			end if
		else
			# move the held ball, leaving a 1-tick velocity
			Part[grab,old_pos_x] = Part[grab,pos_x] : Part[grab,old_pos_y] = Part[grab,pos_y]
			Part[grab,pos_x] = mx : Part[grab,pos_y] = my
		end if
	else
		if grab >= 0 then
#			Part[grab,pinned] = 0                  # release -> it keeps its velocity
			grab = -1
		end if
	end if
end subroutine