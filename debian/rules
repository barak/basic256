#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS=hardening=+all

include /usr/share/dpkg/architecture.mk

BUILDDIR = obj-$(DEB_HOST_GNU_TYPE)

%:
	dh $@

# We need to deal with installing icons CMakeLists.txt doesn't, and
# build-time-generated *.qm files (as opposed to the prebuilt ones)
execute_after_dh_install:
	install -D -m 644 resources/icons/basic256_256.png \
	  debian/basic256/usr/share/icons/hicolor/256x256/apps/basic256.png
	install -D -m 644 -t debian/basic256/usr/share/basic256 \
	  $(BUILDDIR)/basic256_*.qm
