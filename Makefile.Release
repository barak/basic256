	-$(INSTALL_FILE) /home/jim/Desktop/basic256/trunk/Translations/basic256_it.qm $(INSTALL_ROOT)/usr/share/basic256/
	-$(INSTALL_FILE) /home/jim/Desktop/basic256/trunk/Translations/basic256_nl.qm $(INSTALL_ROOT)/usr/share/basic256/
	-$(INSTALL_FILE) /home/jim/Desktop/basic256/trunk/Translations/basic256_pt.qm $(INSTALL_ROOT)/usr/share/basic256/
	-$(INSTALL_FILE) /home/jim/Desktop/basic256/trunk/Translations/basic256_ru.qm $(INSTALL_ROOT)/usr/share/basic256/

uninstall_transFiles: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/basic256/basic256_ru.qm
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/basic256/basic256_pt.qm
