	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/basic256/basic256_de.qm
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/basic256/ 


install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/bin || mkdir -p $(INSTALL_ROOT)/usr/bin
	-$(INSTALL_PROGRAM) "$(QMAKE_TARGET)" "$(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)"
	-$(STRIP) "$(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)"

uninstall_target: FORCE
	-$(DEL_FILE) "$(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)"
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/bin/ 


install:  install_exampleFiles install_helpHTMLFiles install_transFiles install_target  FORCE

uninstall: uninstall_exampleFiles uninstall_helpHTMLFiles uninstall_transFiles uninstall_target   FORCE

