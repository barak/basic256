####### Install

install_exampleFiles: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/basic256 || mkdir -p $(INSTALL_ROOT)/usr/share/basic256
	-$(INSTALL_DIR) /home/jim/Desktop/basic256/trunk/Examples $(INSTALL_ROOT)/usr/share/basic256/

uninstall_exampleFiles: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/basic256/Examples
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/basic256/ 


install_helpHTMLFiles: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/basic256 || mkdir -p $(INSTALL_ROOT)/usr/share/basic256
	-$(INSTALL_DIR) /home/jim/Desktop/basic256/trunk/wikihelp/help $(INSTALL_ROOT)/usr/share/basic256/

uninstall_helpHTMLFiles: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/basic256/help
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/basic256/ 


install_transFiles: first FORCE
