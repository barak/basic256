# testsuite_graphicsheadless_include for BASIC256

# Modification History
# date		programmer	description
# 20260902	m.vilain	original coding
# 20260927	m.vilain	ELLIPSE, IMAGECENTERED, IMAGETRANSFORMED, IMAGESMOOTH, SPRITEO, IMAGETYPE_

currentsuite = "graphicsheadless"

# Everything here draws into an off-screen image resource instead of into the
# graphics window. That path keeps the painter live under --silent, so unlike
# testsuite_graphics_include.kbs -- which asks the user "does this look right?"
# and therefore cannot be automated -- this suite runs unattended and can sit
# in the CI gate.
#
# Every assertion below lands on a whole pixel by exact arithmetic, so it holds
# on every platform. Nothing here depends on how glyphs or curves happen to be
# rasterised, which is where platform differences live.

# ---------------------------------------------------------------------------
# WINDOW maps a logical coordinate space onto the surface
# ---------------------------------------------------------------------------

# 100x100 surface, 10 units across, so one unit is exactly ten pixels
a$ = imagenew(100, 100, rgb(255,255,255))
setgraph a$
window 0, 0, 10, 10
color red
plot 1.5, 1.5
plot 3.7, 2.2
window
call n("window unit maps to 10 pixels", pixel(15,15), red)
call n("and only there", pixel(14,15) = red, 0)
call n("fractional coordinates survive the mapping", pixel(37,22), red)

# 0,0 in the middle of a 500x500 surface
c$ = imagenew(500, 500, rgb(255,255,255))
setgraph c$
window -1, -1, 1, 1
color green
plot 0, 0
call n("window -1,-1,1,1 puts 0,0 in the middle", pixel(0,0), green)
window
call n("which really is the centre pixel", pixel(250,250), green)

# ---------------------------------------------------------------------------
# the argument order chooses which way the y axis runs
# ---------------------------------------------------------------------------

d$ = imagenew(500, 500, rgb(255,255,255))
setgraph d$
window -1, 1, 1, -1
color black
plot 0, 0.996
window
found = 0
for r = 0 to 9
   if pixel(250, r) = black then found = 1
next r
call boolean("window -1,1,1,-1 puts a large y at the top", found)

e$ = imagenew(500, 500, rgb(255,255,255))
setgraph e$
window -1, -1, 1, 1
color black
plot 0, 0.996
window
found = 0
for r = 490 to 499
   if pixel(250, r) = black then found = 1
next r
call boolean("window -1,-1,1,1 puts a large y at the bottom", found)

# ---------------------------------------------------------------------------
# PIXEL is the read-side inverse of PLOT
# ---------------------------------------------------------------------------

f$ = imagenew(200, 200, rgb(255,255,255))
setgraph f$
window -1, -1, 1, 1
color blue
plot 0.5, 0.5
call n("pixel reads back at the coordinate plot wrote", pixel(0.5,0.5), blue)
window
call n("and the same window spans a 200x200 surface", pixel(150,150), blue)

# ---------------------------------------------------------------------------
# PENWIDTH stays in pixels, it does not scale with the window
# ---------------------------------------------------------------------------

g$ = imagenew(100, 100, rgb(255,255,255))
setgraph g$
window 0, 0, 10, 10
penwidth 3
color red
line 0, 5, 10, 5
window
rows = 0
for r = 0 to 99
   if pixel(50, r) = red then rows = rows + 1
next r
call n("penwidth 3 is 3 pixels, not 3 window units", rows, 3)
penwidth 1

# ---------------------------------------------------------------------------
# RECT drops its whole-pixel conventions inside a window
# ---------------------------------------------------------------------------

# rect 0,0,5,5 in a 10-unit window on a 100 pixel surface covers 50 pixels.
# The -1 that makes an integer rectangle span exactly w pixels would stop it
# short at 40, so pixel 45 is what tells the two apart.
h$ = imagenew(100, 100, rgb(255,255,255))
setgraph h$
window 0, 0, 10, 10
color blue
rect 0, 0, 5, 5
window
call n("rect spans the window units asked for", pixel(45,45), blue)
call n("rect starts where it was told", pixel(0,0), blue)

# ---------------------------------------------------------------------------
# IMGLOAD keeps its pixel size, the window places its centre
# ---------------------------------------------------------------------------

# An image is a block of pixels and IMGLOAD has a scale argument of its own,
# so -- like FONT and PENWIDTH -- it does not grow with the window. Only the
# centre is a window coordinate.

j$ = imagenew(20, 20, blue)
setgraph j$
imgsave "testwindowimg.png"
setgraph

k$ = imagenew(100, 100, rgb(255,255,255))
setgraph k$
imgload 50, 50, 1, 0, "testwindowimg.png"
call n("without a window imgload centres on the pixel asked for", pixel(50,50), blue)
call n("and covers its own 20 pixels", pixel(40,40), blue)
call boolean("and no more", pixel(39,39) <> blue)

l$ = imagenew(100, 100, rgb(255,255,255))
setgraph l$
window 0, 0, 10, 10
imgload 5, 5, 1, 0, "testwindowimg.png"
window
call n("the window places the centre", pixel(50,50), blue)
call n("the image is still 20 pixels across", pixel(40,40), blue)
call n("and 20 down", pixel(59,59), blue)
call boolean("the window does not magnify it", pixel(39,39) <> blue)
call boolean("nor stretch it to the far edge", pixel(60,60) <> blue)

kill "testwindowimg.png"
call same("delete temp imgload image", exists("testwindowimg.png"), false)

# ---------------------------------------------------------------------------
# GETSLICE and PUTSLICE are a pair, and the window does not break the pair
# ---------------------------------------------------------------------------

# The corner is a window coordinate, as it is for PIXEL, but the width and
# height stay a count of pixels -- so the array comes back the size asked for
# and putslice x,y,getslice(x,y,w,h,l) puts every pixel back where it was.

m$ = imagenew(100, 100, rgb(255,255,255))
setgraph m$
color red
rect 20, 20, 10, 10

window 0, 0, 10, 10
dim sl(1,1)
sl = getslice(2, 2, 10, 10, slice_paint)
call n("getslice returns the pixel count it was asked for", sl[?,], 10)
call n("in both directions", sl[,?], 10)

# wipe the surface, then put the slice back at the coordinate it came from
color white
rect 0, 0, 10, 10
window
call n("the surface really was wiped", pixel(20,20), white)

window 0, 0, 10, 10
putslice 2, 2, sl
window
call n("putslice puts the slice back where getslice took it", pixel(20,20), red)
call n("all of it", pixel(29,29), red)
call boolean("and no more", pixel(30,30) <> red)
call boolean("nor anything before it", pixel(19,19) <> red)

# the same slice put somewhere else follows the window, at its own pixel size
window 0, 0, 10, 10
putslice 5, 5, sl
window
call n("a slice put at another window coordinate lands there", pixel(50,50), red)
call n("still 10 pixels across", pixel(59,59), red)
call boolean("not magnified by the window", pixel(60,60) <> red)

# ---------------------------------------------------------------------------
# WINDOW with no arguments goes back to pixels
# ---------------------------------------------------------------------------

i$ = imagenew(100, 100, rgb(255,255,255))
setgraph i$
window -1, -1, 1, 1
window
color yellow
plot 30, 40
call n("window with no arguments restores pixel coordinates", pixel(30,40), yellow)

# ---------------------------------------------------------------------------
# a window with no width or no height is an error
# ---------------------------------------------------------------------------

goto skipwindowtrap

windowtrap:
return

skipwindowtrap:

onerror windowtrap
window 5, 5, 5, 5
call n("zero sized window raises an error", lasterror, 130)
offerror


# ---------------------------------------------------------------------------
# SPRITEPOLY sizes the sprite from the polygon and the pen
# ---------------------------------------------------------------------------

# Sprites are never composited under --silent, so nothing here can look at
# what was drawn - but spritew and spriteh read the sprite image directly and
# work headlessly, which is enough to pin the geometry.
#
# The sprite is the polygon's bounding box plus the pen width, because
# drawPolygon centres the stroke on the path and half of it falls outside the
# polygon. Where the polygon sits in the plane must not matter: it is moved to
# the corner of the sprite wherever it was drawn.

spritedim 5

penwidth 1
color white, red

# a 30 wide by 5 tall rectangle, at the origin and then moved away from it
spritepoly 0, {0,0, 30,0, 30,5, 0,5}
call n("spritepoly width at the origin", spritew(0), 31)
call n("spritepoly height at the origin", spriteh(0), 6)

spritepoly 1, {5,1, 35,1, 35,6, 5,6}
call n("spritepoly width is the same moved off the origin", spritew(1), 31)
call n("spritepoly height is the same moved off the origin", spriteh(1), 6)

# wholly negative coordinates - and not square, so a swapped axis would show
spritepoly 2, {-40,-30, -10,-30, -10,-25, -40,-25}
call n("spritepoly width with negative coordinates", spritew(2), 31)
call n("spritepoly height with negative coordinates", spriteh(2), 6)

# the pen is allowed for on both sides of the polygon
penwidth 4
spritepoly 3, {0,0, 30,0, 30,5, 0,5}
call n("a wider pen makes a wider sprite", spritew(3), 34)
call n("a wider pen makes a taller sprite", spriteh(3), 9)

# a two dimensional list of points is accepted for the same shape
penwidth 1
spritepoly 4, {{0,0}, {30,0}, {30,5}, {0,5}}
call n("2d list of points gives the same width", spritew(4), 31)
call n("2d list of points gives the same height", spriteh(4), 6)

penwidth 1

# SPRITEW and SPRITEH report the size the sprite covers on screen, so they
# follow the scale and rotation handed to SPRITEPLACE -- the same transformed
# image that SPRITECOLLIDE and the redraw region already work from. A program
# testing x > graphwidth - spritew(n)/2 needs the size it can actually see.

penwidth 1
spritepoly 0, {0,0, 40,0, 40,40, 0,40}
call n("an unplaced sprite is its own size", spritew(0), 41)
spriteplace 0, 100, 100, 3
call n("scale 3 makes spritew three times as wide", spritew(0), 123)
call n("and spriteh three times as tall", spriteh(0), 123)
spriteplace 0, 100, 100, 1
call n("back at scale 1 spritew is the original width", spritew(0), 41)
call n("and spriteh the original height", spriteh(0), 41)

# a quarter turn swaps a wide sprite for a tall one. The bounding box of a
# rotated rectangle is not a whole number of pixels, so this asks which way
# round it is rather than for an exact size.
spriteplace 1, 50, 50, 1, pi/2
call boolean("a quarter turn makes a wide sprite tall", spritew(1) < spriteh(1))
spriteplace 1, 50, 50, 1, 0
call n("and turning it back restores the width", spritew(1), 31)
call n("and the height", spriteh(1), 6)

# ---------------------------------------------------------------------------
# SPRITETEXT makes a sprite the size of the text in the current font
# ---------------------------------------------------------------------------

# The pixel size of text depends on the fonts installed, so these compare one
# sprite with another rather than asking for exact sizes.
spritetext 2, "Hi"
call boolean("spritetext makes a sprite with width", spritew(2) > 0)
call boolean("and height", spriteh(2) > 0)
spritetext(3, "Hi there, sprites")
call boolean("longer text makes a wider sprite", spritew(3) > spritew(2))
call n("on the same line height", spriteh(3), spriteh(2))
spritetext 4, "Hi", yellow
call n("a background colour does not change the width", spritew(4), spritew(2))
call n("or the height", spriteh(4), spriteh(2))

# ---------------------------------------------------------------------------
# ELLIPSE, and drawing an image centred or warped onto the surface
# ---------------------------------------------------------------------------

e$ = imagenew(100, 100, rgb(255,255,255))
setgraph e$
color red
ellipse 10, 20, 60, 30
call n("ellipse fills its centre", pixel(40, 35), red)
call boolean("ellipse leaves the corners of its box alone", pixel(11, 21) <> red)

# a 10x10 blue square to draw with
sq$ = imagenew(10, 10, blue)
f$ = imagenew(100, 100, rgb(255,255,255))
setgraph f$
imagecentered sq$, 50, 50
call n("imagecentered puts the middle of the image on the point", pixel(50, 50), blue)
call boolean("and reaches half its size either side", pixel(46, 46) = blue and pixel(53, 53) = blue)
call boolean("and no further", pixel(43, 43) <> blue and pixel(56, 56) <> blue)
imagecentered sq$, 20, 20, 2
call boolean("imagecentered scales about the centre", pixel(12, 12) = blue and pixel(27, 27) = blue)
call boolean("to twice the size and no more", pixel(7, 7) <> blue and pixel(32, 32) <> blue)

g$ = imagenew(100, 100, rgb(255,255,255))
setgraph g$
imagetransformed sq$, 60, 60, 90, 60, 90, 90, 60, 90
call n("imagetransformed stretches the image to the four corners", pixel(75, 75), blue)
call boolean("and covers the whole quadrilateral", pixel(62, 62) = blue and pixel(88, 88) = blue)
call boolean("and nothing outside it", pixel(55, 55) <> blue and pixel(95, 95) <> blue)

# IMAGESMOOTH chooses how a scaled image is sampled: a 2x1 black and white
# image blown up ten times is two hard blocks without it, and grades from one
# to the other with it.  The image lands on x 10 to 29, so only the inside is read
bw$ = imagenew(2, 1, white)
imagesetpixel bw$, 0, 0, black
h$ = imagenew(40, 20, rgb(255,0,0))
setgraph h$
imagesmooth false
imagecentered bw$, 20, 10, 10
graded = 0
for x = 11 to 28
   if pixel(x, 10) <> black and pixel(x, 10) <> white then graded = graded + 1
next x
call n("imagesmooth false scales to hard blocks", graded, 0)
imagesmooth true
imagecentered bw$, 20, 10, 10
graded = 0
for x = 11 to 28
   if pixel(x, 10) <> black and pixel(x, 10) <> white then graded = graded + 1
next x
call boolean("imagesmooth true grades between them", graded > 0)
imagesmooth false
unload sq$
unload bw$

# SPRITEO reads back the opacity SPRITEPLACE gave a sprite
spriteplace 1, 50, 50, 1, 0, .25
call nclose("spriteo reads back the opacity spriteplace set", spriteo(1), .25)
spriteplace 1, 50, 50, 1, 0, 1
call nclose("and a fully opaque sprite reads 1", spriteo(1), 1)

# the image type constants IMGSAVE takes
call same("imagetype_png", imagetype_png, "PNG")
call same("IMAGETYPE_PNG in capitals", IMAGETYPE_PNG, "PNG")
call same("imagetype_jpg", imagetype_jpg, "JPG")
call same("imagetype_bmp", imagetype_bmp, "BMP")

# leave the drawing state as it was found so later suites are unaffected
window
setgraph
penwidth 1
